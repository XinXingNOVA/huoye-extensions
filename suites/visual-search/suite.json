    "packages/visual-search.hyplugin",
    "packages/embed-apple.hyplugin",
    "packages/embed-classic.hyplugin",
    "packages/embed-clip.hyplugin",
    "packages/vision-studio.hyplugin",
    "packages/vision-apple.hyplugin",
    "packages/pureboard.hyplugin",
    "packages/palette.hyplugin",
    "packages/annotate.hyplugin",
    "packages/collection.hyplugin",
    "packages/tags.hyplugin",
    "packages/tag-groups.hyplugin",
    "packages/rating.hyplugin",
    "packages/note.hyplugin",
    "packages/table.hyplugin",
    "packages/vision-tesseract.hyplugin"
