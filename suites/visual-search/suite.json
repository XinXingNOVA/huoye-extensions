  "presets": [
    {
      "id": "visual-search",
      "recommendedTheme": "silver-gelatin",
      "title": "灵图检索 · 以图/文搜图与去重",
      "description": "以图搜图、外图拖入直搜、相似灵感侧栏与重复连拍清理；配 Chinese-CLIP 运行包可开启中英文文搜图。",
      "plugins": [
        "preview",
        "image",
        "visual-search",
        "embed-apple",
        "pureboard",
        "palette",
        "annotate",
        "collection",
        "tags",
        "tag-groups",
        "rating",
        "note",
        "table"
      ],
      "layout": {
        "version": 1,
        "root": {
          "type": "group",
          "id": "main"
        },
        "primary": "main",
        "panels": {
          "sidebar": true,
          "inspector": true
        },
        "panelSizes": {
          "sidebar": 260,
          "inspector": 330
        },
        "sidebars": {
          "version": 4,
          "containers": [
            {
              "id": "host.navigation",
              "side": "left",
              "type": "tabs",
              "views": [
                "host.navigation"
              ],
              "active": "host.navigation"
            },
            {
              "id": "host.context",
              "side": "right",
              "type": "context",
              "views": [],
              "active": "",
              "contexts": {
                "collection": {
                  "tools": [
                    "host.filters",
                    "visual-search.similar-panel"
                  ],
                  "active": "visual-search.similar-panel"
                }
              }
            },
            {
              "id": "host.inspector",
              "side": "right",
              "type": "tabs",
              "views": [
                "host.inspector"
              ],
              "active": "host.inspector"
            }
          ],
          "selected": {
            "left": "host.navigation",
            "right": "host.context"
          },
          "hidden": [],
          "weights": {
            "host.navigation": 1,
            "host.context": 0.54,
            "host.inspector": 0.46
          }
        },
        "contents": {
          "main": {
            "items": [
              {
                "kind": "page",
