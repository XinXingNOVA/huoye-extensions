{
  "formatVersion": 1,
  "id": "design-studio",
  "title": "设计工坊",
  "version": "0.1.0",
  "description": "面向品牌与视觉设计的资产工作台：字体试打墙与可变轴、PSD/PSB 图层审稿、SVG 图标调色、3D 模型展台与灵感参考板。",
  "packages": [
    "packages/font-studio.hyplugin",
    "packages/psd-studio.hyplugin",
    "packages/svg-studio.hyplugin",
    "packages/mesh-viewer.hyplugin",
    "packages/pureboard.hyplugin",
    "packages/palette.hyplugin",
    "packages/image-filter.hyplugin",
    "packages/gallery.hyplugin",
    "packages/annotate.hyplugin",
    "packages/collection.hyplugin",
    "packages/tags.hyplugin",
    "packages/tag-groups.hyplugin",
    "packages/rating.hyplugin",
    "packages/status.hyplugin",
    "packages/note.hyplugin",
    "packages/table.hyplugin"
  ],
  "presets": [
    {
      "id": "studio",
      "recommendedTheme": "silver-gelatin",
      "title": "综合设计资产库",
      "description": "统一管理字体、PSD、SVG、3D 模型与图片参考，按选中类型自动切换工具栏。",
      "plugins": [
        "preview",
        "image",
        "font-studio",
        "psd-studio",
        "svg-studio",
        "mesh-viewer",
        "pureboard",
        "palette",
        "image-filter",
        "gallery",
        "annotate",
        "collection",
        "tags",
        "tag-groups",
        "rating",
        "status",
        "note",
        "table"
      ],
      "layout": {
        "version": 1,
        "root": {
          "type": "group",
          "id": "main"
        },
        "primary": "main",
        "panels": {
          "sidebar": true,
          "inspector": true
        },
        "panelSizes": {
          "sidebar": 280,
          "inspector": 310
        },
        "sidebars": {
          "version": 4,
          "containers": [
            {
              "id": "host.navigation",
              "side": "left",
              "type": "tabs",
              "views": [
                "host.navigation"
              ],
              "active": "host.navigation"
            },
            {
              "id": "host.context",
              "side": "left",
              "type": "context",
              "views": [],
              "active": "",
              "contexts": {
                "collection": {
                  "tools": [
                    "host.filters"
                  ],
                  "active": "host.filters"
                }
              }
            },
            {
              "id": "host.inspector",
              "side": "right",
              "type": "tabs",
              "views": [
                "host.inspector"
              ],
              "active": "host.inspector"
            }
          ],
          "selected": {
            "left": "host.navigation",
            "right": "host.inspector"
          },
          "hidden": [],
          "weights": {
            "host.navigation": 0.45,
            "host.context": 0.55,
            "host.inspector": 1
          }
        },
        "contents": {
          "main": {
            "items": [
              {
                "kind": "page",
                "type": "collection",
                "target": {
                  "presetId": "all"
                },
                "presentation": {
                  "layout": "masonry",
                  "options": {},
                  "zoom": 240
                }
              }
            ],
            "active": 0
          }
        }
      }
    },
    {
