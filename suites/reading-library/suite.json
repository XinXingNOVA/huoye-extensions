{
  "formatVersion": 1,
  "id": "reading-library",
  "title": "青瓷书房",
  "version": "0.1.0",
  "description": "一站式个人藏书与精读空间：支持 EPUB、Kindle、PDF、漫画画集与长篇 TXT，配备实体书架、书目台账与书摘回跳。",
  "packages": [
    "packages/epub.hyplugin",
    "packages/ebook-reader.hyplugin",
    "packages/book-meta.hyplugin",
    "packages/bookshelf.hyplugin",
    "packages/comic.hyplugin",
    "packages/txt-reader.hyplugin",
    "packages/highlights.hyplugin",
    "packages/annotate.hyplugin",
    "packages/collection.hyplugin",
    "packages/tags.hyplugin",
    "packages/tag-groups.hyplugin",
    "packages/rating.hyplugin",
    "packages/status.hyplugin",
    "packages/note.hyplugin",
    "packages/table.hyplugin"
  ],
  "presets": [
    {
      "id": "bookshelf",
      "recommendedTheme": "celadon-reading",
      "title": "青瓷书房 · 书架模式",
      "description": "按书架陈列多格式藏书与阅读进度，随阅读自动切出章节目录与批注。",
      "plugins": [
        "preview",
        "pdf",
        "text",
        "image",
        "epub",
        "ebook-reader",
        "book-meta",
        "bookshelf",
        "comic",
        "txt-reader",
        "highlights",
        "annotate",
        "collection",
        "tags",
        "tag-groups",
        "rating",
        "status",
        "note",
        "table"
      ],
      "layout": {
        "version": 1,
        "root": {
          "type": "group",
          "id": "main"
        },
        "primary": "main",
        "panels": {
          "sidebar": true,
          "inspector": true
        },
        "panelSizes": {
          "sidebar": 280,
          "inspector": 310
        },
        "sidebars": {
          "version": 4,
          "containers": [
            {
              "id": "host.navigation",
              "side": "left",
              "type": "tabs",
              "views": [
                "host.navigation"
              ],
              "active": "host.navigation"
            },
            {
              "id": "host.context",
              "side": "left",
              "type": "context",
              "views": [],
              "active": "",
              "contexts": {
                "collection": {
                  "tools": [
                    "host.filters"
                  ],
                  "active": "host.filters"
                }
              }
            },
            {
              "id": "host.inspector",
              "side": "right",
              "type": "tabs",
              "views": [
                "host.inspector"
              ],
              "active": "host.inspector"
            }
          ],
          "selected": {
            "left": "host.navigation",
            "right": "host.inspector"
          },
          "hidden": [],
          "weights": {
            "host.navigation": 0.45,
            "host.context": 0.55,
            "host.inspector": 1
          }
        },
        "contents": {
          "main": {
            "items": [
              {
                "kind": "page",
                "type": "collection",
                "target": {
                  "presetId": "all"
                },
                "presentation": {
                  "layout": "bookshelf",
                  "options": {
                    "shelfStyle": "celadon",
                    "groupBy": "none",
                    "showProgress": true,
                    "showFormat": true,
                    "showAuthor": true
                  },
                  "zoom": 140
                }
              },
              {
                "kind": "page",
                "type": "bookshelf.desk",
                "target": {}
              }
            ],
            "active": 0
          }
        }
      }
    },
    {
      "id": "catalog",
      "recommendedTheme": "celadon-reading",
      "title": "书目台账 · 编目模式",
