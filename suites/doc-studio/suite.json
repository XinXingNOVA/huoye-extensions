{
  "formatVersion": 1,
  "id": "doc-studio",
  "title": "办公与档案工坊",
  "version": "0.1.0",
  "description": "面向日常文档、数据表与归档包的全离线工作台：直读 Word/PPT/RTF 与全文检索、PDF 合并拆分水印、压缩包免解压检索以及十万行表格分析。",
  "packages": [
    "packages/office-lens.hyplugin",
    "packages/pdf-forge.hyplugin",
    "packages/archive-peek.hyplugin",
    "packages/data-lens.hyplugin",
    "packages/annotate.hyplugin",
    "packages/collection.hyplugin",
    "packages/tags.hyplugin",
    "packages/tag-groups.hyplugin",
    "packages/rating.hyplugin",
    "packages/status.hyplugin",
    "packages/note.hyplugin",
    "packages/table.hyplugin",
    "packages/format-forge.hyplugin",
    "packages/source.hyplugin",
    "packages/fields.hyplugin"
  ],
  "presets": [
    {
      "id": "office-reading",
      "recommendedTheme": "celadon-reading",
      "title": "文档精读与全文检索",
      "description": "阅读 DOCX、PPTX、RTF 与 PDF，正文与演讲者备注自动进入全局全文搜索。",
      "plugins": [
        "preview",
        "pdf",
        "image",
        "text",
        "office-lens",
        "pdf-forge",
        "archive-peek",
        "data-lens",
        "annotate",
        "collection",
        "tags",
        "tag-groups",
        "rating",
        "status",
        "note",
        "table"
      ],
      "layout": {
        "version": 1,
        "root": {
          "type": "group",
          "id": "main"
        },
        "primary": "main",
        "panels": {
          "sidebar": true,
          "inspector": true
        },
        "panelSizes": {
          "sidebar": 270,
          "inspector": 330
        },
        "sidebars": {
          "version": 4,
          "containers": [
            {
              "id": "host.navigation",
              "side": "left",
              "type": "tabs",
              "views": [
                "host.navigation"
              ],
              "active": "host.navigation"
            },
            {
              "id": "host.context",
              "side": "left",
              "type": "context",
              "views": [],
              "active": "",
              "contexts": {
                "collection": {
                  "tools": [
                    "host.filters"
                  ],
                  "active": "host.filters"
                }
              }
            },
            {
              "id": "host.inspector",
              "side": "right",
              "type": "tabs",
              "views": [
                "host.inspector"
              ],
              "active": "host.inspector"
            }
          ],
          "selected": {
            "left": "host.navigation",
            "right": "host.inspector"
          },
          "hidden": [],
          "weights": {
            "host.navigation": 0.45,
            "host.context": 0.55,
            "host.inspector": 1
          }
        },
        "contents": {
          "main": {
            "items": [
              {
                "kind": "page",
                "type": "collection",
                "target": {
                  "presetId": "all"
                },
                "presentation": {
                  "layout": "masonry",
                  "options": {},
                  "zoom": 230
                }
              },
              {
                "kind": "page",
                "type": "collection",
                "target": {
                  "presetId": "office-lens.documents"
                },
                "presentation": {
                  "layout": "masonry",
                  "options": {},
                  "zoom": 220
                }
              },
              {
                "kind": "page",
                "type": "collection",
                "target": {
                  "presetId": "pdfs"
                },
                "presentation": {
                  "layout": "masonry",
                  "options": {},
                  "zoom": 220
                }
              }
            ],
            "active": 0
          }
        }
      }
    },
